# ---------------------------------------------------------------------------
# Diabetes Risk Prediction Web App - environment configuration
#
# Copy this file to `.env` in the project root and fill in what you need:
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
#
# `.env` is git-ignored. Never commit a real API key.
#
# Every value here is optional. With no .env file at all the app still runs:
# it serves the model normally and composes explanations from its own WHO/IDF
# knowledge base instead of calling a language model.
# ---------------------------------------------------------------------------

# --- Flask -----------------------------------------------------------------

# "development" enables the debugger and template auto-reload.
# Use "production" for anything other than local development.
FLASK_ENV=development

# Entry point, for `flask --app run run`.
FLASK_APP=run.py

# Interface and port for `python run.py`.
#
# The default is 8137 rather than 5000 on purpose. Windows reserves parts of the
# ephemeral port range, and 5000 in particular is commonly taken (by AirPlay on
# macOS too), while 8000 and 8080 are usually already in use by something else.
# If startup fails with "An attempt was made to access a socket in a way
# forbidden by its access permissions", the port is unavailable - pick another.
FLASK_HOST=127.0.0.1
FLASK_PORT=8137

# Signs session cookies. Leave unset in development and a random key is
# generated at each start. REQUIRED in production - set a long random value,
# for example the output of:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=


# --- LLM narrative layer (Groq) --------------------------------------------

# Which provider writes the clinical explanation.
#   groq     Groq's free hosted open models   (default)
#   openai   OpenAI
#   gemini   Google Gemini
#   none     skip the API entirely and always use the knowledge-base writer
LLM_PROVIDER=groq

# Your Groq API key. Free to create at https://console.groq.com/keys
# (You can also export GROQ_API_KEY in your shell instead of setting it here.)
LLM_API_KEY=

# Pin a specific model. Leave blank to use the default for the provider:
#   groq     openai/gpt-oss-120b
#   openai   gpt-4o-mini
#   gemini   gemini-2.0-flash
#
# Other good free Groq models:
#   openai/gpt-oss-20b        smaller and faster
#   llama-3.3-70b-versatile   Llama 3.3
#   llama-3.1-8b-instant      fastest
LLM_MODEL=

# Reasoning effort for Groq's gpt-oss models: none | low | medium | high.
# The prompt supplies every clinical fact, so this is a rewriting task rather
# than a reasoning one - "low" keeps it inside a web-request latency budget.
LLM_EFFORT=low

# Seconds to wait for the provider before falling back to the knowledge-base
# writer. The result page has already rendered by then, so this is not a
# page-load blocker.
LLM_TIMEOUT_SECONDS=45

# Set to false to disable live LLM calls without removing your key.
LLM_ENABLED=true
